# Copy to .env and fill secrets (never commit .env)

# --- PostgreSQL ---
# Must include ?schema=app (Prisma manages only the "app" schema).
#
# Local dev (pnpm dev on host, DB in Docker):
DATABASE_URL="postgresql://timeblock:timeblock_password@localhost:5432/timeblock_db?schema=app"
#
# Full Docker stack (app container → db service); used by docker-compose app override:
# DATABASE_URL="postgresql://timeblock:timeblock_password@db:5432/timeblock_db?schema=app"
#
# Vercel + Neon (production): use Neon connection string with ?schema=app
# Prefer Neon *pooled* URL in Vercel env; use *direct* URL locally for migrate deploy.
# See docs/DEPLOYMENT_VERCEL_NEON.md

# --- Auth.js (https://authjs.dev/getting-started/deployment) ---
# Generate: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
# Recommended for local dev and Docker behind port mapping
AUTH_TRUST_HOST=true

# GitHub OAuth App (https://github.com/settings/developers)
# Callback URL must match AUTH_URL origin + /api/auth/callback/github
# Default: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# development | production
NODE_ENV=development

# Calendar timezone fallback (IANA). Only when calendar_time_zone cookie is not set yet.
# Server resolution: cookie calendar_time_zone → this env → UTC.
# User-facing pages (/calendar, /dashboard, /review, /time-blocks) use getUserCalendarTimeZone().
# NEXT_PUBLIC_CALENDAR_TIMEZONE=Asia/Shanghai
