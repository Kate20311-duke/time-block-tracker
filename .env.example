# Copy to .env and fill secrets (never commit .env)

# --- PostgreSQL ---
# Must include ?schema=app (Prisma manages only the "app" schema).
#
# Local dev (pnpm dev on host, DB in Docker):
DATABASE_URL="postgresql://timeblock:timeblock_password@localhost:5432/timeblock_db?schema=app"
#
# Full Docker stack (app container → db service); used by docker-compose app override:
# DATABASE_URL="postgresql://timeblock:timeblock_password@db:5432/timeblock_db?schema=app"

# --- Auth.js (https://authjs.dev/getting-started/deployment) ---
# Generate: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
# Recommended for local dev and Docker behind port mapping
AUTH_TRUST_HOST=true

# GitHub OAuth App (https://github.com/settings/developers)
# Callback URL must match AUTH_URL origin + /api/auth/callback/github
# Default: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# development | production
NODE_ENV=development
