generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["app"]
}

// Auth.js Prisma Adapter (https://authjs.dev/getting-started/adapters/prisma)
model User {
  id            String     @id @default(cuid())
  name          String?
  email         String?    @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  categories    Category[]
  routines      Routine[]

  @@schema("app")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@schema("app")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("app")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@schema("app")
}

model Category {
  id            String         @id @default(cuid())
  name          String
  color         String
  description   String?
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  timeBlocks    TimeBlock[]
  focusSessions FocusSession[]
  routines      Routine[]

  @@index([userId])
  @@schema("app")
}

model Routine {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  startTime  String
  endTime    String
  daysOfWeek Int[]
  startDate  DateTime
  endDate    DateTime?
  isActive   Boolean   @default(true)
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
  @@index([categoryId])
  @@index([userId, isActive])
  @@schema("app")
}

model TimeBlock {
  id              String        @id @default(cuid())
  title           String
  note            String?
  startTime       DateTime
  endTime         DateTime
  status          String        @default("planned")
  completionLevel Int           @default(0)
  efficiencyLevel String?
  reviewNote      String?
  source          String        @default("manual")
  categoryId      String
  category        Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  focusSession    FocusSession?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@schema("app")
}

model FocusSession {
  id                     String     @id @default(cuid())
  title                  String?
  note                   String?
  mode                   String     @default("pomodoro")
  categoryId             String
  category               Category   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  startTime              DateTime
  endTime                DateTime?
  plannedDurationMinutes Int
  actualDurationMinutes  Int?
  status                 String     @default("planned")
  convertedToTimeBlock   Boolean    @default(false)
  timeBlockId            String?    @unique
  timeBlock              TimeBlock? @relation(fields: [timeBlockId], references: [id], onDelete: SetNull)
  pausedAt               DateTime?
  pausedTotalSeconds     Int        @default(0)
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  @@schema("app")
}
